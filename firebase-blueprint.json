{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Customer account profile, address, and delivery coordinates",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Active and scheduled tiffin subscription plans with meal slot and pause preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "mealSlot": { "type": "string" },
        "status": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerId"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Kitchen chefs, packing staff, managers, and delivery riders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "role"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer ratings, satisfaction scores and public reviews",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "mealSlot": { "type": "string" },
        "mealPlanName": { "type": "string" },
        "verified": { "type": "boolean" },
        "date": { "type": "string" }
      },
      "required": ["id", "rating"]
    },
    "Delivery": {
      "title": "Delivery",
      "description": "Scheduled daily meal delivery unit with dispatch and status tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subscriptionId": { "type": "string" },
        "customerId": { "type": "string" },
        "deliveryDate": { "type": "string" },
        "mealSlot": { "type": "string" },
        "status": { "type": "string" },
        "riderId": { "type": "string" }
      },
      "required": ["id", "subscriptionId", "deliveryDate"]
    },
    "Order": {
      "title": "Order",
      "description": "Payment transactions, plan subscriptions, and receipts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "planId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerId", "amount"]
    },
    "PackingTask": {
      "title": "PackingTask",
      "description": "Kitchen meal packaging station tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deliveryId": { "type": "string" },
        "customerName": { "type": "string" },
        "mealSlot": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "deliveryId", "status"]
    },
    "DoorstepPaymentRequest": {
      "title": "DoorstepPaymentRequest",
      "description": "Rider doorstep payment and cash collection requests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "customerId", "amount", "status"]
    },
    "LedgerEntry": {
      "title": "LedgerEntry",
      "description": "Financial accounting and customer balance ledger logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "customerId", "amount", "type"]
    },
    "KitchenHandover": {
      "title": "KitchenHandover",
      "description": "Batch handover record from kitchen cooking station to delivery riders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "mealSlot": { "type": "string" },
        "riderId": { "type": "string" },
        "tiffinCount": { "type": "number" }
      },
      "required": ["id", "date", "mealSlot"]
    },
    "DeletedStaffRegistry": {
      "title": "DeletedStaffRegistry",
      "description": "Permanent tombstone records for removed staff accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "staffId": { "type": "string" },
        "deletedAt": { "type": "string" }
      },
      "required": ["id", "staffId"]
    }
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer accounts and delivery profiles"
    },
    "/subscriptions/{subscriptionId}": {
      "schema": "Subscription",
      "description": "Customer meal subscriptions and delivery cycles"
    },
    "/staff/{staffId}": {
      "schema": "Staff",
      "description": "Kitchen and logistics staff roster"
    },
    "/public_reviews/{reviewId}": {
      "schema": "Review",
      "description": "Public customer reviews and ratings"
    },
    "/deliveries/{deliveryId}": {
      "schema": "Delivery",
      "description": "Daily scheduled tiffin delivery records"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Billing, subscription payments, and orders"
    },
    "/packing_tasks/{taskId}": {
      "schema": "PackingTask",
      "description": "Kitchen packing station checklist"
    },
    "/doorstep_payment_requests/{reqId}": {
      "schema": "DoorstepPaymentRequest",
      "description": "Cash and UPI collection on doorstep delivery"
    },
    "/ledger_entries/{entryId}": {
      "schema": "LedgerEntry",
      "description": "Customer ledger and billing adjustments"
    },
    "/KITCHEN_HANDOVERS/{handoverId}": {
      "schema": "KitchenHandover",
      "description": "Batch handover logs to delivery team"
    },
    "/deleted_staff_registry/{regId}": {
      "schema": "DeletedStaffRegistry",
      "description": "Permanent tombstones for deleted staff IDs"
    }
  }
}
