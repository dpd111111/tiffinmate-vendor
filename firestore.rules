rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all unspecified routes to prevent unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwnerEmail() {
      return isSignedIn() && request.auth.token.email == "navovianext@gmail.com";
    }

    // Public Customer Reviews & Testimonials
    match /public_reviews/{reviewId} {
      allow read, write: if true;
    }

    // Staff Roster
    match /staff/{staffId} {
      allow read, write: if true;
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Subscriptions Collection
    match /subscriptions/{subscriptionId} {
      allow read, write: if true;
    }

    // Daily Deliveries & Dispatches
    match /deliveries/{deliveryId} {
      allow read, write: if true;
    }

    // Orders & Billing Records
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Kitchen Packing Tasks
    match /packing_tasks/{taskId} {
      allow read, write: if true;
    }

    // Doorstep Cash/UPI Payment Requests
    match /doorstep_payment_requests/{reqId} {
      allow read, write: if true;
    }

    // Customer Financial Ledger Entries
    match /ledger_entries/{entryId} {
      allow read, write: if true;
    }

    // Kitchen to Rider Handover Records
    match /KITCHEN_HANDOVERS/{handoverId} {
      allow read, write: if true;
    }

    // Deleted Staff Registry Tombstones
    match /deleted_staff_registry/{regId} {
      allow read, write: if true;
    }

    // Secure Server Staff Vault
    match /server_staff_vault/{vaultId} {
      allow read, write: if true;
    }

    // App Snapshots Collection for Permanent Backup
    match /app_snapshots/{snapId} {
      allow read, write: if true;
    }

    // Connection Healthcheck Ping Document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
